# คัดลอกเป็น .env.local แล้วแก้ตามเครื่องตัวเอง — .env.local ถูก gitignore ไว้แล้ว
#
#   cp .env.example .env.local
#
# ไฟล์นี้มีอยู่เพราะ src/api/client.ts อ่านสองตัวแปรนี้ แต่ไม่มีที่ไหนบอกว่ามีอยู่
# คนเข้าใหม่จึงไม่มีทางรู้ว่าสลับ mock ↔ backend จริงได้ยังไง

# true / ไม่ตั้งค่า = ใช้ mock ใน src/mocks/ (ค่าเริ่มต้น ปลอดภัยสุด — ยังไม่ต้องมี backend)
# false            = ยิง backend จริงตาม VITE_API_BASE_URL
#
# ⚠️ client.ts เช็คว่า `!== "false"` เท่านั้น — สะกดผิดเป็น "FALSE" หรือ "0"
#    จะยังเป็น mock อยู่ ไม่ error ให้เห็น
VITE_USE_MOCK=true

# ใช้เมื่อ VITE_USE_MOCK=false เท่านั้น
VITE_API_BASE_URL=http://localhost:8000/api/v1
