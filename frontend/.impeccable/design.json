  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Supported primary action",
      "html": "<button class=\"ds-button\" type=\"button\">Open match</button>",
      "css": ".ds-button{font:600 14px var(--f-ui,Arial,sans-serif);padding:8px 16px;min-height:40px;color:var(--accent-ink,#0A0810);background:var(--teal,#3AAE7C);border:1px solid var(--teal,#3AAE7C);border-radius:var(--r,2px);box-shadow:2px 2px 0 var(--ink,#0A0810);cursor:pointer;transition:background .15s ease,color .15s ease}.ds-button:hover{background:var(--bone,#E5DCC8);color:var(--void,#14121C)}.ds-button:disabled{opacity:.5;cursor:not-allowed}.ds-button:focus-visible,.ds-input:focus-visible,.ds-region:focus-visible{outline:3px solid var(--teal,#3AAE7C);outline-offset:2px;}"
    },
    {
      "name": "Workspace panel",
      "kind": "card",
      "refersTo": "workspace-panel",
      "description": "Calm working surface",
      "html": "<section class=\"ds-panel\"><h2>Needs you</h2><p>Review the pending invitation.</p></section>",
      "css": ".ds-panel{padding:20px;background:var(--panel,#1E1B2A);color:var(--bone,#E5DCC8);border:1px solid var(--line,#362F49);border-radius:var(--r,2px);font:14px/1.6 var(--f-ui,Arial,sans-serif)}.ds-panel h2{margin:0;font:700 24px var(--f-display,Arial,sans-serif)}.ds-panel p{margin:12px 0 0;color:var(--bone-dim,#C7BBA0)}"
    },
    {
      "name": "Working input",
      "kind": "input",
      "refersTo": "typography.body",
      "description": "Labelled account field",
      "html": "<label class=\"ds-field\">Email<input class=\"ds-input\" type=\"email\" autocomplete=\"email\"></label>",
      "css": ".ds-field{display:grid;gap:6px;color:var(--bone,#E5DCC8);font:14px var(--f-ui,Arial,sans-serif)}.ds-input{min-height:44px;padding:8px 12px;font:16px var(--f-ui,Arial,sans-serif);color:var(--bone,#E5DCC8);background:var(--panel-2,#262234);border:1px solid var(--line-hot,#7C6F94);border-radius:var(--r,2px)}.ds-input:hover{border-color:var(--bone-dim,#C7BBA0)}.ds-input[aria-invalid=true]{border-color:var(--red-text,#FF6E80)}.ds-button:focus-visible,.ds-input:focus-visible,.ds-region:focus-visible{outline:3px solid var(--teal,#3AAE7C);outline-offset:2px;}"
    },
    {
      "name": "Status badge",
      "kind": "chip",
      "refersTo": "colors.amber",
      "description": "Word plus caution fill",
      "html": "<span class=\"ds-badge\">Pending</span>",
      "css": ".ds-badge{display:inline-flex;padding:1px 8px;gap:6px;font:600 13px var(--f-ui,Arial,sans-serif);background:var(--amber,#D9A430);color:var(--accent-ink,#0A0810);border-radius:var(--r,2px)}"
    },
    {
      "name": "Bounded region",
      "kind": "custom",
      "refersTo": "workspace-panel",
      "description": "Long working queue",
      "html": "<section class=\"ds-region\" role=\"region\" aria-label=\"Pending work\" tabindex=\"0\"><p>Review Northside Community Championship.</p><p>Review the squad invitation.</p></section>",
      "css": ".ds-region{height:320px;overflow:auto;overscroll-behavior:contain;padding:16px;background:var(--panel,#1E1B2A);color:var(--bone,#E5DCC8);border:1px solid var(--line,#362F49);border-radius:var(--r,2px);font:14px/1.6 var(--f-ui,Arial,sans-serif)}.ds-region p{padding:12px 0;border-bottom:1px solid var(--line,#362F49)}.ds-button:focus-visible,.ds-input:focus-visible,.ds-region:focus-visible{outline:3px solid var(--teal,#3AAE7C);outline-offset:2px;}"
    },
    {
      "name": "Dialog surface",
      "kind": "custom",
      "refersTo": "modal",
      "description": "Static visual anatomy; use shared Modal in React",
      "html": "<section class=\"ds-modal\"><h2>Review request</h2><p>Confirm the venue before approving.</p></section>",
      "css": ".ds-modal{width:min(560px,100%);max-height:86vh;overflow:auto;padding:24px;background:var(--panel,#1E1B2A);color:var(--bone,#E5DCC8);border:1px solid var(--line-hot,#7C6F94);border-radius:var(--r,2px);box-shadow:var(--lift,0 14px 30px -16px rgba(0,0,0,.9));font:14px/1.6 var(--f-ui,Arial,sans-serif)}.ds-modal h2{font:700 24px var(--f-display,Arial,sans-serif);margin:0}.ds-modal p{margin:12px 0 0}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button",
      "description": "Supporting action",
      "html": "<button class=\"ds-secondary\" type=\"button\">Cancel</button>",
      "css": ".ds-secondary{font:600 14px var(--f-ui,Arial,sans-serif);min-height:40px;padding:8px 16px;border:1px solid var(--line-hot,#7C6F94);border-radius:var(--r,2px);background:var(--panel-3,#302B41);color:var(--bone,#E5DCC8);cursor:pointer}.ds-secondary:hover{background:var(--panel-4,#3D3653)}.ds-secondary:active{background:var(--panel-2,#262234)}.ds-secondary:focus-visible{outline:3px solid var(--teal,#3AAE7C);outline-offset:2px}.ds-secondary:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "name": "Danger button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Explicit destructive action",
      "html": "<button class=\"ds-danger\" type=\"button\">Decline</button>",
      "css": ".ds-danger{font:600 14px var(--f-ui,Arial,sans-serif);min-height:40px;padding:8px 16px;border:1px solid var(--red,#EA4658);border-radius:var(--r,2px);background:var(--red,#EA4658);color:var(--accent-ink,#0A0810);cursor:pointer}.ds-danger:hover{background:var(--red-lift,#FF5A70)}.ds-danger:focus-visible{outline:3px solid var(--teal,#3AAE7C);outline-offset:2px}.ds-danger:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "name": "Sidebar navigation",
      "kind": "nav",
      "refersTo": "colors.teal",
      "description": "Permitted route parent, active in teal",
      "html": "<nav class=\"ds-nav\" aria-label=\"Example navigation\"><a href=\"#home\" aria-current=\"page\">Home</a><a href=\"#tournaments\">Tournaments</a></nav>",
      "css": ".ds-nav{display:grid;width:232px;background:var(--panel,#1E1B2A);font:600 14px var(--f-ui,Arial,sans-serif)}.ds-nav a{padding:12px 16px;min-height:20px;color:var(--bone-dim,#C7BBA0);text-decoration:none;border-left:2px solid transparent}.ds-nav a:hover{background:var(--panel-2,#262234);color:var(--bone,#E5DCC8)}.ds-nav a[aria-current]{background:var(--teal,#3AAE7C);color:var(--accent-ink,#0A0810);border-left-color:var(--ink,#0A0810)}.ds-nav a:focus-visible{outline:3px solid var(--teal,#3AAE7C);outline-offset:2px}"
    }
  ],
  "narrative": {
    "northStar": "Minimal Street",
    "overview": "The approved B workspace uses A's Tournament discovery and plum/cream palette. Condensed lettering and angular edges carry the retro street identity; working controls use a calm, readable sans serif. Tournament previews alone use the approved wall texture and pasted word strips.",
    "keyCharacteristics": [
      "232px desktop sidebar",
      "Short English actions",
      "2px corners",
      "Bounded queues",
      "Explicit source/access states"
    ],
    "rules": [
      {
        "name": "Source Truth",
        "body": "Loading, denied and unavailable data never become a fabricated empty or successful state. Color reinforces a named state; it does not establish permission.",
        "section": "colors"
      },
      {
        "name": "Preview Exception",
        "body": "self-hosted Rubik Dirt appears only in Tournament preview word strips: 48px/1.3, 32px for long titles; narrow variants use 36px/24px. Tracking stays at -.02em. Facts retain the UI face. Long names wrap rather than enlarge the page.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do reuse the CSS tokens, existing kit contracts and feature stylesheets.",
      "Do keep labels short and put the problem and recovery in error text.",
      "Do retain drafts through recoverable source/mutation failures and hide content on actual denial.",
      "Do keep unavailable capabilities explicit and preserve API/DTO/payload/access contracts."
    ],
    "donts": [
      "Don't add decorative metrics or actions unsupported by delivered data.",
      "Don't apply wall texture, Rubik Dirt or sticker rotations to ordinary forms and queues.",
      "Don't equate fixture/browser evidence with live backend or device acceptance."
    ]
  }
}
