# ═══ API integration test (npm run test:int) ═══
# คัดลอกเป็น backend/.env.test แล้วใส่ DB_PASSWORD ให้ตรงกับ .env
#
# 🔴 DB_NAME ต้องลงท้ายด้วย _test — เทสจะ DROP ฐานนี้แล้วสร้างใหม่ทุกครั้งที่รัน
#    (มีด่านกันอยู่ใน loadTestEnv.ts ถ้าชื่อไม่ลงท้าย _test จะไม่ยอมรัน)
# ใช้ MySQL ตัวเดียวกับ dev (docker compose · พอร์ต 3307) แค่คนละฐาน — ไม่ต้องเปิด container เพิ่ม
# DB_USER ต้องมีสิทธิ์ CREATE/DROP DATABASE (root ของ container มีอยู่แล้ว)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=ltms_test

JWT_SECRET=integration-test-secret
JWT_EXPIRES_IN=1h
PORT=0

# S3 กับ SMTP ไม่ถูกใช้จริงในเทส (S3 ถูกบล็อก · SMTP ถูกแทนด้วย mailbox) แต่ config/env.ts บังคับให้มีค่า
S3_ENDPOINT=http://no-s3.invalid
S3_REGION=test-region
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_BUCKET=test
