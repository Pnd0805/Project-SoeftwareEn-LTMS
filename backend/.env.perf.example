# ═══ Performance / load test (npm run perf) ═══
# คัดลอกเป็น backend/.env.perf แล้วใส่ DB_PASSWORD ให้ตรงกับ .env
#
# 🔴 DB_NAME ต้องลงท้ายด้วย _perf — สคริปต์จะ DROP ฐานนี้แล้วสร้างใหม่ + seed ข้อมูล ~30,000 บัญชีทุกครั้ง
#    (มีด่านกันอยู่ใน perf/lib/env.ts ถ้าชื่อไม่ลงท้าย _perf จะไม่ยอมรัน)
# MySQL ตัวเดียวกับ dev/integration (docker compose · พอร์ต 3307) แค่คนละฐาน
# 🔴 MySQL ต้องรันเป็น UTC (default-time-zone=+00:00) — แอปอ่าน DATETIME เป็น UTC
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=ltms_perf

JWT_SECRET=perf-test-secret-change-me
JWT_EXPIRES_IN=1d
# พอร์ตของเซิร์ฟเวอร์ที่สคริปต์เปิดเอง — ต้องไม่ชนกับ npm run dev (ปกติ 3000)
PORT=3999

# ไม่ได้ใช้จริงระหว่างวัด แต่ config/env.ts บังคับให้มีค่า
S3_ENDPOINT=http://127.0.0.1:9
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=perf
S3_SECRET_ACCESS_KEY=perf
S3_BUCKET=perf
# ชี้ SMTP ไปพอร์ตที่ไม่มีใครฟัง ⇒ ถ้ามีเส้นไหนส่งเมลระหว่างวัด จะล้มเร็วและโผล่ใน log ให้เห็น
SMTP_HOST=127.0.0.1
SMTP_PORT=9
