DB_HOST=
DB_USER=
DB_PASSWORD=
DB_PORT=
DB_NAME=

# ใช้โดย docker-compose.yml ตอน **สร้าง container ครั้งแรก** เท่านั้น (ไม่ใช่โดยแอป)
# ต้องใส่ให้ **ตรงกับ DB_PASSWORD ข้างบน** ไม่อย่างนั้นแอปจะต่อฐานไม่ได้ (ER_ACCESS_DENIED_ERROR)
# 🔴 ไม่ใส่ = compose ตีเป็นค่าว่าง ⇒ ได้ mysql ที่ root ไม่มีรหัสเลย และ healthcheck ก็ส่ง -p เปล่า
#   คนที่มี volume mysql_data อยู่แล้วจะไม่เห็นปัญหา เพราะรหัสถูกตั้งไว้ตอนสร้างครั้งแรกไปแล้ว
#   ⇒ มันจะระเบิดกับคนที่ clone ใหม่ หรือวันที่ใครสั่ง docker compose down -v
MYSQL_ROOT_PASSWORD=

PORT=
JWT_SECRET=
# อายุ token — ตัวเลขวินาที (604800) หรือมีหน่วย s/m/h/d (7d)
JWT_EXPIRES_IN=
# secret เซ็น QR เช็คอิน (M11) แยกจาก login — ไม่ใส่ = ใช้ JWT_SECRET แทน (production ควรตั้งแยก)
CHECKIN_QR_SECRET=

S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# true สำหรับ MinIO (dev) / false สำหรับ AWS S3 จริง (production) — ไม่ใส่ = true
S3_FORCE_PATH_STYLE=

# SMTP development default: local Mailpit (localhost:1025), no credentials required.
# Brevo example (use in backend/.env ONLY after you have an approved SMTP account and verified sender):
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_REQUIRE_TLS=true
# SMTP_USER=<copy SMTP Login from Brevo SMTP & API page>
# SMTP_PASS=<Brevo SMTP KEY, never an API key; never commit or paste into chat>
# MAIL_FROM=LTMS <verified-sender@your-own-domain.example>
# SMTP_TEST_TO=<one-or-two-recipient-addresses-separated-by-commas> (for npm run test:smtp:brevo only)
SMTP_HOST=
SMTP_PORT=
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
FRONTEND_URL=

# Email notification delivery (separate from OTP/reset emails). Off until migrations + SMTP are configured.
# When true: critical immediately, other categories daily at 08:00 Thailand time.
EMAIL_NOTIFICATIONS_ENABLED=false

# C2 — log คำขอที่ใช้เวลาเกินกี่ ms (0 = ปิดสนิท) · ไม่ตั้ง = 2000
# ของเดิมไม่มี log อะไรเลย ⇒ ตอน load test คำขอค้างจน timeout 2,000+ ครั้ง แต่ log ว่างเปล่า
SLOW_REQUEST_MS=

# C3 — ขนาด pool ของ MySQL (ไม่ตั้ง = 10) · ปรับตามเครื่องตอน deploy
# 🔴 ไม่ใช่ปุ่มเร่งความเร็ว — ฐานมี max_connections ของตัวเอง และคิวรีที่ช้าก็ยังช้าเท่าเดิม
DB_POOL_SIZE=

# C4 — อายุ keep-alive ของเซิร์ฟเวอร์ (ไม่ตั้ง = 65000)
# ต้อง **มากกว่า** idle timeout ของ reverse proxy ที่อยู่หน้าเรา (nginx ตั้งต้น 60 วินาที)
# ไม่งั้นจะเจอ 502 ประปราย เพราะ Node ปิด connection พอดีจังหวะที่ proxy ส่งคำขอใหม่เข้ามา
KEEP_ALIVE_TIMEOUT_MS=

# มติ 8 ต.ค. 2569 — งานเบื้องหลังรันตามเวลา (กวาดทีมร้าง + ปิดทัวร์ที่ยังไม่เผยแพร่จนถึงวันแข่ง)
# ไม่ตั้ง = ชั่วโมงละครั้ง (3600000) · 0 = ปิดสนิท
# ของเดิมกวาดตอนมีคนเปิดหน้าทีม ⇒ คนอ่านเป็นคนจ่ายค่ากวาด และเป็นคอขวด P1 ของ load test
JOB_INTERVAL_MS=
# หน่วงรอบแรกหลังเซิร์ฟเวอร์ขึ้น (ไม่ตั้ง = 10000) — ไม่แย่ง connection กับคำขอชุดแรก
JOB_STARTUP_DELAY_MS=

# OD-53 (29 ต.ค. 2569) — บังคับยืนยันอีเมลก่อนเข้าสู่ระบบ (ไม่ตั้ง / ไม่ใช่ "true" = ปิด)
# 🔴 เปิดเป็น true ได้เฉพาะเมื่อเครื่องนั้น **ส่งเมลออกได้จริง** แล้วเท่านั้น
#    ไม่งั้นคนสมัครใหม่รอ OTP ที่ไม่มีทางมาถึง = สมัครไม่ได้ทั้งระบบ
#    เครื่องพัฒนาชี้ไป mailpit (docker compose up -d mailpit · ดูเมลที่ http://127.0.0.1:8025) ก็นับว่าส่งได้
# ★ สวิตช์นี้คุมสองอย่างพร้อมกัน: ด่านล็อกอิน และการซ่อนบัญชีที่ยังไม่ยืนยันจากผลค้นหา
REQUIRE_EMAIL_VERIFIED=false
# ลบบัญชีที่สมัครแล้วไม่ยืนยันเกินกี่ชั่วโมง (0 = ไม่ลบ) — เหตุผลเรื่องข้อมูลส่วนบุคคล ไม่ใช่พื้นที่
UNVERIFIED_ACCOUNT_TTL_HOURS=24
